# Copie para .env e ajuste. O .env não é versionado.

# Obrigatória. Conexão com o PostgreSQL.
DATABASE_URL="postgresql://loop:loop@localhost:5432/loop?schema=public"

# Obrigatória. Chave HS256 do JWT. O servidor não sobe se ela tiver menos de
# 32 caracteres ou for um valor de exemplo conhecido.
# Gere uma com: openssl rand -base64 48
SECRET_KEY=""

# Opcional. Origens liberadas no CORS, separadas por vírgula. Sem ela, só
# http://localhost:5173 e http://localhost:3000 são aceitas.
# CORS_ORIGIN="http://localhost:5173"

# Opcional. Padrão 3333 / 0.0.0.0.
# PORT=3333
# HOST=0.0.0.0

# Só na Vercel: conexão direta (sem pooler) com o Neon, usada pelas migrações
# no build. Localmente não é necessária.
# DIRECT_URL=""

# Em produção, use "production": ativa Secure e SameSite=None no cookie de refresh.
# NODE_ENV=development
