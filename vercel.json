{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "src/generated/prisma/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
